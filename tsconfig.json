{
  "compilerOptions": {
    "target": "ES2015",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": [
      "ES2015",
      "DOM"
    ],
    "strict": false,
    "isolatedModules": false,
    "preserveConstEnums": false,
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@mitojs/*": [
        "./packages/*/src"
      ]
    },
    "types": [
      "node",
      "wechat-miniprogram"
    ],
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx"
  ],
  "exclude": [
    "**/__tests__/**"
  ]
}
