{
  "$schema": "https://biomejs.dev/schemas/2.6.5/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "includes": ["scripts/**", "tools/**", "e2e/**", "packages/*/src/**", "test/setup.ts", "vite.config.mjs", "vitest.config.mts", "playwright.config.ts"] },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 140 },
  "javascript": { "formatter": { "semicolons": "asNeeded", "quoteStyle": "single", "trailingCommas": "none" } },
  "linter": { "rules": { "preset": "none", "correctness": { "noUnreachable": "error" }, "suspicious": { "noDuplicateObjectKeys": "error" } } }
}
