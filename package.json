{
  "version": "3.0.1",
  "private": true,
  "license": "MIT",
  "author": "cjinhuo",
  "scripts": {
    "build": "nx run-many -t build --parallel=2 --output-style=static",
    "watch": "nx watch --all --includeGlobalWorkspaceFiles --initialRun -- pnpm build",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.test.json",
    "unit": "vitest run",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:packages": "node --test scripts/verify-packages.mjs",
    "test:e2e": "playwright test",
    "test:consumers": "node scripts/verify-consumers.mjs",
    "test:release": "node --test scripts/verify-release.mjs",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "limit": "size-limit",
    "verify": "pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build && pnpm test:packages && pnpm test:e2e && pnpm test:release && pnpm limit",
    "changeset": "changeset",
    "version:packages": "changeset version",
    "release": "pnpm verify && pnpm changeset publish",
    "prepare": "husky",
    "pack:sdks": "node scripts/pack.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mitojs/mitojs.git"
  },
  "keywords": [
    "mitojs",
    "error",
    "collect",
    "broswer",
    "miniPrograme"
  ],
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@changesets/cli": "catalog:",
    "@microsoft/api-extractor": "catalog:",
    "@playwright/test": "catalog:",
    "@size-limit/file": "catalog:",
    "@types/node": "catalog:",
    "@types/node-fetch": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/wechat-miniprogram": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "acorn": "catalog:",
    "husky": "catalog:",
    "jsdom": "catalog:",
    "node-fetch": "catalog:",
    "nx": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "size-limit": "catalog:",
    "typescript": "catalog:",
    "typescript-4-1": "catalog:",
    "typescript-4-4": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "tslib": "catalog:",
    "@jridgewell/trace-mapping": "catalog:",
    "rolldown": "catalog:"
  },
  "dependencies": {},
  "name": "mitojs-workspace",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "^24.15.0",
    "pnpm": ">=12"
  }
}
